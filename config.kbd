    w;  #(ralt - w ralt - ; XX)
    wn  #(ralt - w ralt - n XX)
    wm  #(ralt - w ralt - m XX)
    w,  #(ralt - w ralt - , XX)
    w.  #(ralt - w ralt - . XX)
    w/  #(ralt - w ralt - / XX)

    rt> (layer-toggle rt>)
    ri  (tap-next-release (around ralt (around ] (around r #(- i XX)))) (around ralt (around ] (around r #(] i (layer-toggle kana0))))))
    ro  (tap-next-release (around ralt (around ] (around r #(- o XX)))) (around ralt (around ] (around r #(] o (layer-toggle kana0))))))
    rp  (tap-next-release (around ralt (around ] (around r #(- p XX)))) (around ralt (around ] (around r #(] p (layer-toggle kana0))))))
    rh  (tap-next-release (around ralt (around ] (around r #(- h XX)))) (around ralt (around ] (around r #(] h (layer-toggle kana0))))))
    rj  (tap-next-release (around ralt (around ] (around r #(- j XX)))) (around ralt (around ] (around r #(] j (layer-toggle kana0))))))
    rk  #(ralt - r ralt - k XX)
