    ug  (around ralt #(] u - g XX))
    ux  (around ralt #(] u - x XX))
    uc  (around ralt #(] u - c XX))
    uv  (around ralt #(] u - v XX))
    uy  (tap-next-press right (around ralt #(] u ] y)))

    iq  (around ralt #(] i - q XX))
    iw> (tap-next-release (around ralt #(] i - w XX)) (layer-toggle iw>))
    ie  (around ralt #(] i - e XX))
