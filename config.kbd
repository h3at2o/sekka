(defcfg
    input  (device-file "/dev/input/by-id/usb-SONiX_USB_DEVICE-event-kbd")
    output (uinput-sink "My KMonad output")
    fallthrough true
)

(defsrc
             1        2        3        4        5        6        7        8        9        0
    tab      q        w        e        r        t        y        u        i        o        p        [
    caps     a        s        d        f        g        h        j        k        l        ;        '        ret
    lsft     z        x        c        v        b        n        m        ,        .        /        rsft
    lctl                                                  spc               ralt
)

(defalias
    ret  (tap-next ret (layer-toggle kan_num))
    tab  (tap-next tab (layer-toggle move))
    esc  (tap-hold-next 240 #(esc P10 (layer-switch roma1)) (layer-toggle zen_num))
    s&s  (tap-next spc lsft)
    s&ks (tap-next spc (layer-toggle shift))
    c&c  (tap-next #(lsft P10 (around lsft rsft) XX) (around lctl (layer-toggle roma0)))
    '&c  (tap-next ' (around rctl (layer-toggle roma0)))
    s&c  (tap-hold-next 180 rsft (around rctl (layer-toggle roma0)))
    kana (layer-switch kana1)
    roma (layer-switch roma1)
    numbers2 (tap-next spc (layer-toggle numbers2))
    zen_num2 (tap-next spc (layer-toggle zen_num2))
    5left #(left left left left left left left)
    5right #(right right right right right right right)
    \(   #(\( \) left)
    [    #([ ] left)
    {    #({ } left)

    q  (tap-next-release (around ralt #(- q XX)) (around ralt #(] q XX)))
    w  (tap-next-release (around ralt #(- w XX)) (around ralt #(] w XX)))
    e  (tap-next-release (around ralt #(- e XX)) (around ralt #(] e XX)))
    r  (tap-next-release (around ralt #(- r XX)) (around ralt #(] r XX)))
    t  (tap-next-release (around ralt #(- t XX)) (around ralt #(] t XX)))
    a  (tap-next-release (around ralt #(- a XX)) (around ralt #(] a XX)))
    s  (tap-next-release (around ralt #(- s XX)) (around ralt #(] s XX)))
    d  (tap-next-release (around ralt #(- d XX)) (around ralt #(] d XX)))
    f  (tap-next-release (around ralt #(- f XX)) (around ralt #(] f XX)))
    g  (tap-next-release (around ralt #(- g XX)) (around ralt #(] g XX)))
    z  (tap-next-release (around ralt #(- z XX)) (around ralt #(] z XX)))
    x  (tap-next-release (around ralt #(- x XX)) (around ralt #(] x XX)))
    c  (tap-next-release (around ralt #(- c XX)) (around ralt #(] c XX)))
    v  (tap-next-release (around ralt #(- v XX)) (around ralt #(] v XX)))
    b  (tap-next-release (around ralt #(- b XX)) (around ralt #(] b XX)))
    y  (tap-next-release (around ralt #(- y XX)) (around ralt #(] y XX)))
    u  (tap-next-release (around ralt #(- u XX)) (around ralt #(] u XX)))
    i  (tap-next-release (around ralt #(- i XX)) (around ralt #(] i XX)))
    o  (tap-next-release (around ralt #(- o XX)) (around ralt #(] o XX)))
    p  (tap-next-release (around ralt #(- p XX)) (around ralt #(] p XX)))
    h  (tap-next-release (around ralt #(- h XX)) (around ralt #(] h XX)))
    j  (tap-next-release (around ralt #(- j XX)) (around ralt #(] j XX)))
    k  (tap-next-release (around ralt #(- k XX)) (around ralt #(] k XX)))
    l  (tap-next-release (around ralt #(- l XX)) (around ralt #(] l XX)))
    ;  (tap-next-release (around ralt #(- ; XX)) (around ralt #(] ; XX)))
    n  (tap-next-release (around ralt #(- n XX)) (around ralt #(] n XX)))
    m  (tap-next-release (around ralt #(- m XX)) (around ralt #(] m XX)))
    ,  (tap-hold-next 180 (around ralt #(- , XX)) (layer-toggle numbers))
    .  (tap-next-release (around ralt #(- . XX)) (around ralt #(] . XX)))
    /  (tap-next-release (around ralt #(- / XX)) (around ralt #(] / XX)))

    Q  #(ralt = q XX)
    W  #(ralt = w XX)
    E  #(ralt = e XX)
    R  #(ralt = r XX)
    T  (around lsft left)
    A  #(ralt = a XX)
    S  #(ralt = s XX)
    D  #(ralt = d XX)
    F  #(ralt = f XX)
    G  #(ralt = g XX)
    Z  #(ralt = z XX)
    X  #(ralt = x XX)
    C  #(ralt = c XX)
    V  #(ralt = v XX)
    B  #(ralt = b XX)
    Y  (around lsft right)
    U  #(ralt = u XX)
    I  #(ralt = i XX)
    O  #(ralt = o XX)
    P  #(ralt = p XX)
    H  #(ralt = h XX)
    J  #(ralt = j XX)
    K  #(ralt = k XX)
    L  #(ralt = l XX)
    :  #(ralt = ; XX)
    N  #(ralt = n XX)
    M  #(ralt = m XX)
    <  #(ralt = , XX)
    >  #(ralt = . XX)
    ?  #(ralt = / XX)

    `  #(ralt - `)
    1  #(ralt - 1)
    2  #(ralt - 2)
    3  #(ralt - 3)
    4  #(ralt - 4)
    5  #(ralt - 5)
    6  #(ralt - 6)
    7  #(ralt - 7)
    8  #(ralt - 8)
    9  #(ralt - 9)
    0  #(ralt - 0)
    -  #(ralt - -)
    =  #(ralt - =)

    ~  #(ralt \_ ~)
    !  #(ralt \_ !)
    @  #(ralt \_ @)
    #  #(ralt \_ #)
    $  #(ralt \_ $)
    %  #(ralt \_ %)
    ^  #(ralt \_ ^)
    &  #(ralt \_ &)
    *  #(ralt \_ *)
    \_ #(ralt \_ \_)
    +  #(ralt \_ +)

    1k  #(ralt = 1)
    2k  #(ralt = 2)
    3k  #(ralt = 3)
    4k  #(ralt = 4)
    5k  #(ralt = 5)
    6k  #(ralt = 6)
    7k  #(ralt = 7)
    8k  #(ralt = 8)
    9k  #(ralt = 9)
    0k  #(ralt = 0)

    \\\\ #(ralt \\ \\)
    \\;  #(ralt \\ ;)
    \\,  #(ralt \\ ,)
    \\.  #(ralt \\ .)
    \\/  #(ralt \\ /)

    || #(ralt | |)
    |: #(ralt | :)
    |< #(ralt | <)
    |> #(ralt | >)
    |? #(ralt | ?)

    -spc #(ralt - spc ralt - spc)
    `.   #(ralt ` . ralt ` .)
    =-   #(ralt = - ralt = - ralt = - ralt = -)
    -`   #(lsft ralt - ` ralt - ' left P5 left)
    \_\( #(lsft ralt \_ \( ralt \_ \) left)
    +\(  #(lsft ralt + \( ralt + \) left)
    ekj  (around ralt #(] k j - e))
    \_!  #(ralt \_ !)
    -[   #(lsft ralt - [ ralt - ] left)
    =[   #(lsft ralt = [ ralt = ] left)
    `<  #(lsft ralt ` < ralt ` > left)
    `/  #(ralt ` /)
    +{   #(lsft ralt + { ralt + } left)
    \_|  #(ralt \_ |)

    wi  (tap-next-release (around ralt (around [ (around w #(- i XX)))) (around ralt (around [ (around w #(] i XX)))))
    wo  #(ralt - w ralt - o XX)
    wp  (tap-next-release (around ralt (around [ (around w #(- p XX)))) (around ralt (around [ (around w #(] p XX)))))
    wh  (tap-next-release (around ralt (around [ (around w #(- h XX)))) (around ralt (around [ (around w #(] h XX)))))
    wj  (tap-next-release (around ralt (around [ (around w #(- j XX)))) (around ralt (around [ (around w #(] j XX)))))
    wk  #(ralt - w ralt - k XX)
